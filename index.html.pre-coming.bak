<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>QSTEMora Club — Qena STEM Aura Club (QSC)</title>
  
  <!-- Google Fonts: Poppins & Outfit -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brandDark: '#0A1926',
            brandDarker: '#07131F',
            brandCard: '#0E2238',
            brandGold: '#F5BC6B',
            brandTeal: '#48A9A6',
            brandCyan: '#38B2AC',
          },
          fontFamily: {
            sans: ['Poppins', 'Outfit', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <!-- Favicon -->
  <link rel="icon" type="image/jpeg" href="assets/images/logo.jpg">

  <!-- Custom Stylesheet -->
  <link rel="stylesheet" href="assets/style.css">
  <link rel="stylesheet" href="css/styles.css">
</head>
<body class="bg-[#071A26] text-white min-h-screen flex flex-col selection:bg-[#F5BC6B] selection:text-[#071A26]">

  <!-- Top Navigation Bar -->
  <header class="sticky top-0 z-40 bg-[#071A26]/95 backdrop-blur-md border-b border-[#0F2F47] transition-all">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">
        
        <!-- Logo & Brand Title -->
        <a href="index.html" class="flex items-center gap-3 group">
          <img src="assets/images/logo.jpg" alt="QSTEMora Club Logo" class="w-11 h-11 rounded-full object-cover shadow-[0_0_12px_rgba(245,188,107,0.4)] border border-[#F5BC6B]/40 group-hover:scale-105 transition-transform duration-300" />
          <div class="flex items-center font-bold text-xl md:text-2xl tracking-tight">
            <span class="text-[#38B2AC]">QSTEM</span><span class="text-[#F5BC6B]">ora</span>
            <span class="text-[#2ECC71] ml-1.5 font-medium text-lg">club</span>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center gap-8">
          <a href="index.html" class="nav-link text-sm font-medium transition-colors hover:text-[#F5BC6B]" data-page="home">
            Home
          </a>
          <a href="subjects.html" class="nav-link text-sm font-medium transition-colors hover:text-[#F5BC6B] flex items-center gap-1.5" data-page="subjects">
            <svg class="w-4 h-4 text-[#38B2AC]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
            Subjects
          </a>
          <a href="about.html" class="nav-link text-sm font-medium transition-colors hover:text-[#F5BC6B]" data-page="about">
            About
          </a>
          <a href="team.html" class="nav-link text-sm font-medium transition-colors hover:text-[#F5BC6B]" data-page="team">
            Team members
          </a>
          <a href="partners.html" class="nav-link text-sm font-medium transition-colors hover:text-[#F5BC6B]" data-page="partners">
            Partners
          </a>
        </nav>

        <!-- Right CTA Button (Links directly to WhatsApp Community) -->
        <div class="hidden md:flex items-center">
          <button class="btn-gold btn-join-trigger text-sm uppercase font-bold tracking-wider px-7 py-2.5">
            JOIN
          </button>
        </div>

        <!-- Mobile Menu Hamburger Button -->
        <div class="flex md:hidden">
          <button id="mobileMenuBtn" class="p-2 rounded-lg text-slate-300 hover:text-white hover:bg-[#0E293E] focus:outline-none">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Drawer Navigation -->
    <div id="mobileMenu" class="hidden md:hidden bg-[#051520] border-b border-[#0F2F47] px-4 pt-2 pb-6 space-y-3">
      <a href="index.html" class="nav-link block py-2 text-base font-medium text-slate-300 hover:text-[#F5BC6B]" data-page="home">Home</a>
      <a href="subjects.html" class="nav-link block py-2 text-base font-medium text-slate-300 hover:text-[#F5BC6B]" data-page="subjects">Subjects</a>
      <a href="about.html" class="nav-link block py-2 text-base font-medium text-slate-300 hover:text-[#F5BC6B]" data-page="about">About</a>
      <a href="team.html" class="nav-link block py-2 text-base font-medium text-slate-300 hover:text-[#F5BC6B]" data-page="team">Team members</a>
      <a href="partners.html" class="nav-link block py-2 text-base font-medium text-slate-300 hover:text-[#F5BC6B]" data-page="partners">Partners</a>
      <div class="pt-2">
        <button class="btn-gold btn-join-trigger w-full text-center py-2.5">JOIN</button>
      </div>
    </div>
  </header>

  <!-- Main View Container -->
  <main class="flex-grow">
    
    <!-- Hero Section -->
    <section class="relative pt-8 pb-14 md:py-20 px-4 max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 text-left space-y-6">
          <div class="inline-flex items-center gap-2 bg-[#0E293E] border border-[#184568] px-3.5 py-1 rounded-full text-xs font-semibold text-[#F5BC6B]">
            <span>✨</span> Built by Senior '28 for Grade 1 STEM Students
          </div>
          <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight leading-tight">
            <span class="text-[#38B2AC] block">Qena STEM</span>
            <span class="text-white">Aura club</span>
          </h1>
          <p class="text-slate-300 text-base md:text-lg max-w-xl font-normal leading-relaxed">
            Centralized study materials for every STEM subject, learning outcome explanations, in-person school hall mentor sessions, and competition guidance for STEM students.
          </p>
          <div class="pt-2 flex flex-wrap gap-4 items-center">
            <button class="btn-gold btn-join-trigger text-base px-8 py-3">JOIN COMMUNITY</button>
            <a href="subjects.html" class="btn-gold-outline text-sm px-6 py-2.5">Browse Subjects →</a>
          </div>
        </div>
        <div class="lg:col-span-6 flex justify-center items-center">
          <div class="relative flex items-center justify-center">
            <div class="absolute w-72 h-72 md:w-96 md:h-96 bg-[#F5BC6B]/20 rounded-full blur-3xl pointer-events-none"></div>
            <img src="assets/images/hero-crest.png" alt="Qena STEM Aura Knowledge Crest" class="relative z-10 w-full max-w-[400px] md:max-w-[460px] h-auto mx-auto object-contain filter drop-shadow-[0_15px_35px_rgba(245,188,107,0.3)] animate-float" />
          </div>
        </div>
      </div>
    </section>

    <!-- Schedule Section: School Hall Sessions (In-Person Only) -->
    <section id="scheduleSection" class="py-12 px-4 bg-[#051520] border-y border-[#0F2F47]">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
          <div>
            <div class="letter-spaced-title text-sm mb-1">S C H O O L &nbsp; H A L L &nbsp; S C H E D U L E</div>
            <h2 class="text-2xl md:text-3xl font-bold text-white flex items-center gap-2.5">
              <span>This Week's School Hall Sessions</span>
              <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-[#0E293E] text-[#2ECC71] border border-[#2ECC71]/30 px-3 py-1 rounded-full">
                <span class="w-2 h-2 rounded-full bg-[#2ECC71] inline-block animate-pulse"></span>
                In-Person (STEM Qena Hall)
              </span>
            </h2>
          </div>
          <p class="text-xs text-slate-400 max-w-md">
            In-person study hall & academic review sessions held in the School Main Hall & Study Labs exclusively for STEM Qena students.
          </p>
        </div>

        <div id="scheduleContainer" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Session: Tuesday — Physics -->
          <div class="schedule-card active-session">
            <div class="flex items-center justify-between gap-2 mb-3">
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold uppercase tracking-wider text-[#F5BC6B]">Tuesday • 15:30 - 17:00</span>
              </div>
              <span class="text-[10px] uppercase font-bold bg-[#0E293E] text-[#2ECC71] border border-[#2ECC71]/30 px-2 py-0.5 rounded-full">In-Person</span>
            </div>
            <h3 class="text-lg font-bold text-white mb-1">Physics</h3>
            <p class="text-xs text-slate-300 font-medium mb-3 line-clamp-2">Electric Flux &amp; Gauss's Law Applications (PH.1.01)</p>
            <div class="space-y-2 pt-2 border-t border-[#143B5C]/60 text-xs">
              <div class="flex items-center gap-1.5 text-[#F5BC6B] font-semibold"><span>📍</span><span class="truncate">School Main Hall (STEM Qena)</span></div>
              <div class="flex items-center justify-between text-slate-400"><span>Presenter: <strong class="text-slate-200">Ziad Ahmed (Senior '26 Physics Curator)</strong></span></div>
              <div class="pt-1"><span class="inline-block bg-[#071A26] border border-[#163E60] text-slate-300 text-[10px] font-semibold px-2 py-0.5 rounded">🔒 Grade 1 STEM Qena Students</span></div>
            </div>
          </div>
          <!-- Session: Wednesday — Chemistry -->
          <div class="schedule-card ">
            <div class="flex items-center justify-between gap-2 mb-3">
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold uppercase tracking-wider text-[#38B2AC]">Wednesday • 16:00 - 17:30</span>
              </div>
              <span class="text-[10px] uppercase font-bold bg-[#0E293E] text-[#2ECC71] border border-[#2ECC71]/30 px-2 py-0.5 rounded-full">In-Person</span>
            </div>
            <h3 class="text-lg font-bold text-white mb-1">Chemistry</h3>
            <p class="text-xs text-slate-300 font-medium mb-3 line-clamp-2">Reaction Kinetics &amp; Rate Laws Problem Solving (CH.1.04)</p>
            <div class="space-y-2 pt-2 border-t border-[#143B5C]/60 text-xs">
              <div class="flex items-center gap-1.5 text-[#F5BC6B] font-semibold"><span>📍</span><span class="truncate">School Study Hall / Lab 2</span></div>
              <div class="flex items-center justify-between text-slate-400"><span>Presenter: <strong class="text-slate-200">Mohanad Naeem (Academic Head)</strong></span></div>
              <div class="pt-1"><span class="inline-block bg-[#071A26] border border-[#163E60] text-slate-300 text-[10px] font-semibold px-2 py-0.5 rounded">🔒 Grade 1 STEM Qena Students</span></div>
            </div>
          </div>
          <!-- Session: Thursday — Math -->
          <div class="schedule-card ">
            <div class="flex items-center justify-between gap-2 mb-3">
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold uppercase tracking-wider text-[#38B2AC]">Thursday • 15:30 - 17:00</span>
              </div>
              <span class="text-[10px] uppercase font-bold bg-[#0E293E] text-[#2ECC71] border border-[#2ECC71]/30 px-2 py-0.5 rounded-full">In-Person</span>
            </div>
            <h3 class="text-lg font-bold text-white mb-1">Math</h3>
            <p class="text-xs text-slate-300 font-medium mb-3 line-clamp-2">Differential Calculus &amp; Related Rates (MA.1.02)</p>
            <div class="space-y-2 pt-2 border-t border-[#143B5C]/60 text-xs">
              <div class="flex items-center gap-1.5 text-[#F5BC6B] font-semibold"><span>📍</span><span class="truncate">School Main Hall (STEM Qena)</span></div>
              <div class="flex items-center justify-between text-slate-400"><span>Presenter: <strong class="text-slate-200">Senior '26 Math Leads</strong></span></div>
              <div class="pt-1"><span class="inline-block bg-[#071A26] border border-[#163E60] text-slate-300 text-[10px] font-semibold px-2 py-0.5 rounded">🔒 Grade 1 STEM Qena Students</span></div>
            </div>
          </div>
          <!-- Session: Saturday — CS &amp; Arduino -->
          <div class="schedule-card ">
            <div class="flex items-center justify-between gap-2 mb-3">
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold uppercase tracking-wider text-[#38B2AC]">Saturday • 14:00 - 15:30</span>
              </div>
              <span class="text-[10px] uppercase font-bold bg-[#0E293E] text-[#2ECC71] border border-[#2ECC71]/30 px-2 py-0.5 rounded-full">In-Person</span>
            </div>
            <h3 class="text-lg font-bold text-white mb-1">CS &amp; Arduino</h3>
            <p class="text-xs text-slate-300 font-medium mb-3 line-clamp-2">Python OOP Logic &amp; Sensor Interfacing (CS.1.01 &amp; ARD.1.01)</p>
            <div class="space-y-2 pt-2 border-t border-[#143B5C]/60 text-xs">
              <div class="flex items-center gap-1.5 text-[#F5BC6B] font-semibold"><span>📍</span><span class="truncate">School Multi-Purpose Hall</span></div>
              <div class="flex items-center justify-between text-slate-400"><span>Presenter: <strong class="text-slate-200">Mostafa Tarek (Tech Lead)</strong></span></div>
              <div class="pt-1"><span class="inline-block bg-[#071A26] border border-[#163E60] text-slate-300 text-[10px] font-semibold px-2 py-0.5 rounded">🔒 Grade 1 STEM Qena Students</span></div>
            </div>
          </div>
      </div>
      </div>
    </section>

    <!-- About Us Teaser Section -->
    <section class="py-16 px-4 max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-5 flex justify-center">
          <div class="relative flex items-center justify-center p-2">
            <div class="w-full max-w-[320px] md:max-w-[380px] aspect-square rounded-full overflow-hidden shadow-[0_20px_40px_rgba(0,0,0,0.5)] border-4 border-[#38B2AC]/40 hover:scale-105 transition-transform duration-500 bg-[#A8DADC]">
              <img src="assets/images/about-puzzle.jpg" alt="Collaborative STEM Teamwork Puzzle" class="w-full h-full object-cover" />
            </div>
          </div>
        </div>
        <div class="lg:col-span-7 space-y-5 text-left">
          <div class="letter-spaced-title text-base">A b o u t &nbsp; U s</div>
          <h2 class="text-3xl md:text-4xl font-bold text-white">Innovative Way To Learn</h2>
          <p class="text-slate-300 text-base leading-relaxed">
            We, students of Qena STEM School from different governorates, Seniors 26, faced many problems and difficulties in studying, so we decided to help students from all governorates by collecting study information and explaining it in a constructive way for schools of outstanding students in science, technology, engineering, and mathematics (STEM) and for general secondary schools.
          </p>
          <div>
            <a href="about.html" class="btn-gold text-sm px-6 py-2.5 inline-block">learn more</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Subjects Preview Grid -->
    <section class="py-16 px-4 bg-[#051520] border-t border-[#0F2F47]">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-10">
          <div>
            <div class="letter-spaced-title text-sm mb-1">C U R R I C U L U M</div>
            <h2 class="text-3xl md:text-4xl font-bold text-white">Subjects</h2>
          </div>
          <div class="relative">
            <select id="homeSemesterSelect" class="bg-[#0A2233] border border-[#163E60] text-[#F5BC6B] font-semibold py-2 px-4 pr-9 rounded-full appearance-none cursor-pointer focus:outline-none">
              <option value="all">Semester (All) ▾</option>
              <option value="1">Semester 1 ▾</option>
              <option value="2">Semester 2 ▾</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-4 gap-6" id="homeSubjectsGrid">
        <!-- Subject card: Geology (scientific) -->
        <a href="subject.html?s=geology" class="subject-card group" data-category="scientific" data-semesters="1,2" data-name="geology" data-desc="earth systems, plate tectonics, mineralogy, stratigraphy, and geological processes." hidden>
          <div class="transform group-hover:scale-110 transition-transform duration-300">
            <svg viewBox="0 0 120 120" class="w-16 h-16 md:w-20 md:h-20 mx-auto">
        <defs>
          <linearGradient id="volcanoGrad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#E74C3C" />
            <stop offset="40%" stop-color="#D35400" />
            <stop offset="100%" stop-color="#5D4037" />
          </linearGradient>
        </defs>
        <ellipse cx="60" cy="100" rx="45" ry="12" fill="#3E2723" />
        <polygon points="60,35 25,95 95,95" fill="url(#volcanoGrad)" />
        <polygon points="60,35 48,95 72,95" fill="#E67E22" />
        <path d="M50 35 Q60 15 70 35 Q65 42 60 38 Q55 42 50 35 Z" fill="#F1C40F" />
        <circle cx="60" cy="20" r="4" fill="#E74C3C" />
        <circle cx="50" cy="15" r="3" fill="#F39C12" />
        <circle cx="70" cy="17" r="3.5" fill="#F1C40F" />
      </svg>
          </div>
          <div class="subject-title">Geology</div>
          <div class="text-xs text-slate-400 mt-1 capitalize">scientific • Sem 1 &amp; 2</div>
        </a>
        <!-- Subject card: Math (scientific) -->
        <a href="subject.html?s=math" class="subject-card group" data-category="scientific" data-semesters="1,2" data-name="math" data-desc="differential and integral calculus, linear algebra, analytical geometry, and probability." hidden>
          <div class="transform group-hover:scale-110 transition-transform duration-300">
            <svg viewBox="0 0 120 120" class="w-16 h-16 md:w-20 md:h-20 mx-auto">
        <rect x="30" y="25" width="60" height="70" rx="8" fill="#ECEFF1" stroke="#37474F" stroke-width="3" />
        <rect x="38" y="33" width="44" height="18" rx="3" fill="#80CBC4" stroke="#004D40" stroke-width="1.5" />
        <text x="60" y="47" font-family="monospace" font-weight="bold" font-size="11" fill="#004D40" text-anchor="middle">8 x ∞ = π</text>
        <circle cx="45" cy="60" r="4" fill="#37474F" />
        <circle cx="60" cy="60" r="4" fill="#37474F" />
        <circle cx="75" cy="60" r="4" fill="#FF7043" />
        <circle cx="45" cy="72" r="4" fill="#37474F" />
        <circle cx="60" cy="72" r="4" fill="#37474F" />
        <circle cx="75" cy="72" r="4" fill="#42A5F5" />
        <circle cx="45" cy="84" r="4" fill="#37474F" />
        <circle cx="60" cy="84" r="4" fill="#66BB6A" />
        <circle cx="75" cy="84" r="4" fill="#FFA726" />
        <text x="18" y="35" font-weight="bold" font-size="14" fill="#F7B731">∑</text>
        <text x="96" y="40" font-weight="bold" font-size="14" fill="#48DBFB">√</text>
        <text x="16" y="85" font-weight="bold" font-size="16" fill="#FF6B6B">∫</text>
      </svg>
          </div>
          <div class="subject-title">Math</div>
          <div class="text-xs text-slate-400 mt-1 capitalize">scientific • Sem 1 &amp; 2</div>
        </a>
        <!-- Subject card: Chemistry (scientific) -->
        <a href="subject.html?s=chemistry" class="subject-card group" data-category="scientific" data-semesters="1,2" data-name="chemistry" data-desc="thermodynamics, chemical kinetics, atomic theory, equilibrium, and electrochemistry." hidden>
          <div class="transform group-hover:scale-110 transition-transform duration-300">
            <svg viewBox="0 0 120 120" class="w-16 h-16 md:w-20 md:h-20 mx-auto">
        <defs>
          <linearGradient id="chemPotion" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#2ECC71" />
            <stop offset="100%" stop-color="#16A085" />
          </linearGradient>
        </defs>
        <path d="M54 25 L66 25 L66 45 L90 85 C94 92 88 100 80 100 L40 100 C32 100 26 92 30 85 L54 45 Z" fill="#112233" stroke="#FFF" stroke-width="3" />
        <path d="M35 88 C45 84 55 92 65 86 C75 80 82 86 85 88 L80 98 L40 98 Z" fill="url(#chemPotion)" />
        <circle cx="50" cy="75" r="4" fill="#58D68D" opacity="0.8" />
        <circle cx="65" cy="65" r="5" fill="#58D68D" opacity="0.8" />
        <path d="M52 25 Q60 5 72 18 Q85 10 92 25 Q95 40 85 45" fill="none" stroke="#2ECC71" stroke-width="3.5" stroke-linecap="round" opacity="0.9" />
        <circle cx="75" cy="18" r="3" fill="#F1C40F" />
      </svg>
          </div>
          <div class="subject-title">Chemistry</div>
          <div class="text-xs text-slate-400 mt-1 capitalize">scientific • Sem 1 &amp; 2</div>
        </a>
        <!-- Subject card: Biology (scientific) -->
        <a href="subject.html?s=biology" class="subject-card group" data-category="scientific" data-semesters="1,2" data-name="biology" data-desc="cellular respiration, molecular genetics, biotechnology, and physiological systems." hidden>
          <div class="transform group-hover:scale-110 transition-transform duration-300">
            <svg viewBox="0 0 120 120" class="w-16 h-16 md:w-20 md:h-20 mx-auto">
        <circle cx="60" cy="60" r="48" fill="#162A3E" stroke="#38B2AC" stroke-width="1.5" />
        <rect x="35" y="90" width="50" height="8" rx="4" fill="#78909C" />
        <rect x="56" y="70" width="8" height="22" fill="#546E7A" />
        <path d="M60 70 C75 70 82 55 78 40 L70 42 C74 52 68 62 60 62 Z" fill="#90A4AE" />
        <rect x="42" y="68" width="30" height="4" fill="#CFD8DC" />
        <rect x="46" y="32" width="10" height="28" transform="rotate(-25 46 32)" fill="#37474F" rx="2" />
        <circle cx="88" cy="35" r="7" fill="#E91E63" />
        <circle cx="98" cy="48" r="5" fill="#9C27B0" />
      </svg>
          </div>
          <div class="subject-title">Biology</div>
          <div class="text-xs text-slate-400 mt-1 capitalize">scientific • Sem 1 &amp; 2</div>
        </a>
