  <!-- Modal Container -->
  <div id="modalBackdrop" class="fixed inset-0 z-50 modal-overlay hidden items-center justify-center p-4 overflow-y-auto">
    <div id="modalContainer" class="modal-content rounded-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto text-left relative transform transition-all"></div>
  </div>

  <!-- Static subject page controller: shows the right cards from HTML (no data fetch needed) -->
  <script>
    (function () {
      var params = new URLSearchParams(window.location.search);
      var s = (params.get('s') || '').toLowerCase();
      var b = (params.get('b') || '').toLowerCase();

      var groups = Array.prototype.slice.call(document.querySelectorAll('.subject-group'));
      var losContainer = document.getElementById('losContainer');
      var branchPicker = document.getElementById('branchPickerContainer');
      var empty = document.getElementById('subjectLOsEmpty');
      var semSelect = document.getElementById('subjectSemesterSelect');
      var semWrapper = document.getElementById('subjectSemesterWrapper');
      var titleEl = document.getElementById('subjectTitle');
      var descEl = document.getElementById('subjectDescription');
      var badgeEl = document.getElementById('subjectCategoryBadge');
      var crumbEl = document.getElementById('subjectBranchBreadcrumb');

      if (!s) { window.location.href = 'subjects.html'; return; }

      var subjGroups = groups.filter(function (g) { return g.dataset.subject === s; });
      if (!subjGroups.length) { window.location.href = 'subjects.html'; return; }

      var hasBranches = subjGroups.some(function (g) { return g.dataset.branch; });
      var meta = subjGroups[0].dataset;

      if (titleEl) titleEl.textContent = (meta.name || s).split('').join(' ');
      if (descEl) descEl.textContent = meta.description || '';
      if (badgeEl) badgeEl.textContent = (meta.category || '').toUpperCase();

      if (hasBranches && !b) {
        branchPicker.classList.remove('hidden');
        losContainer.classList.add('hidden');
        if (semWrapper) semWrapper.classList.add('hidden');
        return;
      }

      branchPicker.classList.add('hidden');
      losContainer.classList.remove('hidden');
      if (semWrapper) semWrapper.classList.remove('hidden');
      if (b && crumbEl) { crumbEl.classList.remove('hidden'); crumbEl.textContent = '> ' + b.toUpperCase(); }

      var active = hasBranches
        ? subjGroups.filter(function (g) { return g.dataset.branch === b; })[0]
        : subjGroups[0];

      groups.forEach(function (g) { g.hidden = true; });

      function applyFilter() {
        var sem = semSelect ? semSelect.value : 'all';
        if (!active) { if (empty) empty.classList.remove('hidden'); return; }
        active.hidden = false;
        var cards = Array.prototype.slice.call(active.querySelectorAll('.lo-card'));
        var visible = 0;
        cards.forEach(function (c) {
          var ok = (sem === 'all') || (c.dataset.semester === sem);
          c.hidden = !ok;
          if (ok) visible++;
        });
        if (empty) empty.classList.toggle('hidden', visible > 0);
        active.hidden = (visible === 0);
      }

      if (semSelect) semSelect.addEventListener('change', applyFilter);
      applyFilter();
    })();
  </script>

  <!-- Application Scripts -->
  <script src="assets/assets.js"></script>
  <script src="assets/app.js"></script>
</body>
</html>

