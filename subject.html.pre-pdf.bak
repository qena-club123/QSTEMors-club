<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Subject Learning Outcomes — QSTEMora Club</title>
  
  <!-- Google Fonts: Poppins & Outfit -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brandDark: '#0A1926',
            brandDarker: '#07131F',
            brandCard: '#0E2238',
            brandGold: '#F5BC6B',
            brandTeal: '#48A9A6',
            brandCyan: '#38B2AC',
          },
          fontFamily: {
            sans: ['Poppins', 'Outfit', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <!-- Favicon -->
  <link rel="icon" type="image/jpeg" href="assets/images/logo.jpg">

  <!-- Custom Stylesheet -->
  <link rel="stylesheet" href="assets/style.css">
  <link rel="stylesheet" href="css/styles.css">
</head>
<body class="bg-[#071A26] text-white min-h-screen flex flex-col selection:bg-[#F5BC6B] selection:text-[#071A26]">

  <!-- Top Navigation Bar -->
  <header class="sticky top-0 z-40 bg-[#071A26]/95 backdrop-blur-md border-b border-[#0F2F47] transition-all">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">
        
        <!-- Logo & Brand Title -->
        <a href="index.html" class="flex items-center gap-3 group">
          <img src="assets/images/logo.jpg" alt="QSTEMora Club Logo" class="w-11 h-11 rounded-full object-cover shadow-[0_0_12px_rgba(245,188,107,0.4)] border border-[#F5BC6B]/40 group-hover:scale-105 transition-transform duration-300" />
          <div class="flex items-center font-bold text-xl md:text-2xl tracking-tight">
            <span class="text-[#38B2AC]">QSTEM</span><span class="text-[#F5BC6B]">ora</span>
            <span class="text-[#2ECC71] ml-1.5 font-medium text-lg">club</span>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center gap-8">
          <a href="index.html" class="nav-link text-sm font-medium transition-colors hover:text-[#F5BC6B]" data-page="home">
            Home
          </a>
          <a href="subjects.html" class="nav-link text-sm font-medium transition-colors hover:text-[#F5BC6B] flex items-center gap-1.5" data-page="subjects">
            <svg class="w-4 h-4 text-[#38B2AC]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
            Subjects
          </a>
          <a href="about.html" class="nav-link text-sm font-medium transition-colors hover:text-[#F5BC6B]" data-page="about">
            About
          </a>
          <a href="team.html" class="nav-link text-sm font-medium transition-colors hover:text-[#F5BC6B]" data-page="team">
            Team members
          </a>
          <a href="partners.html" class="nav-link text-sm font-medium transition-colors hover:text-[#F5BC6B]" data-page="partners">
            Partners
          </a>
        </nav>

        <!-- Right CTA Button -->
        <div class="hidden md:flex items-center">
          <button class="btn-gold btn-join-trigger text-sm uppercase font-bold tracking-wider px-7 py-2.5">
            JOIN
          </button>
        </div>

        <!-- Mobile Menu Hamburger Button -->
        <div class="flex md:hidden">
          <button id="mobileMenuBtn" class="p-2 rounded-lg text-slate-300 hover:text-white hover:bg-[#0E293E] focus:outline-none">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Drawer Navigation -->
    <div id="mobileMenu" class="hidden md:hidden bg-[#051520] border-b border-[#0F2F47] px-4 pt-2 pb-6 space-y-3">
      <a href="index.html" class="nav-link block py-2 text-base font-medium text-slate-300 hover:text-[#F5BC6B]" data-page="home">Home</a>
      <a href="subjects.html" class="nav-link block py-2 text-base font-medium text-slate-300 hover:text-[#F5BC6B]" data-page="subjects">Subjects</a>
      <a href="about.html" class="nav-link block py-2 text-base font-medium text-slate-300 hover:text-[#F5BC6B]" data-page="about">About</a>
      <a href="team.html" class="nav-link block py-2 text-base font-medium text-slate-300 hover:text-[#F5BC6B]" data-page="team">Team members</a>
      <a href="partners.html" class="nav-link block py-2 text-base font-medium text-slate-300 hover:text-[#F5BC6B]" data-page="partners">Partners</a>
      <div class="pt-2">
        <button class="btn-gold btn-join-trigger w-full text-center py-2.5">JOIN</button>
      </div>
    </div>
  </header>

  <!-- Main View Container -->
  <main class="flex-grow py-12 px-4 max-w-7xl mx-auto w-full">
    
    <!-- Top Subject Header & Controls -->
    <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
      <div>
        <div class="flex items-center gap-3">
          <span id="subjectCategoryBadge" class="text-[11px] font-bold tracking-widest text-[#38B2AC] uppercase bg-[#38B2AC]/10 border border-[#38B2AC]/30 px-3 py-0.5 rounded-full">
            SCIENTIFIC
          </span>
          <span id="subjectBranchBreadcrumb" class="hidden text-xs font-bold text-[#F5BC6B] uppercase"></span>
        </div>
        <h1 id="subjectTitle" class="text-3xl md:text-5xl font-extrabold text-white tracking-tight letter-spaced-title mt-1.5">
          S u b j e c t
        </h1>
        <p id="subjectDescription" class="text-xs md:text-sm text-slate-300 mt-1 max-w-2xl">
          Loading curriculum syllabus and learning outcomes...
        </p>
      </div>

      <div class="flex items-center gap-3">
        <!-- Semester Filter -->
        <div id="subjectSemesterWrapper" class="relative">
          <select id="subjectSemesterSelect" class="bg-[#F5BC6B] text-[#071A26] font-bold py-2 px-5 pr-9 rounded-full appearance-none cursor-pointer focus:outline-none shadow-md text-sm">
            <option value="all">Semester (All) ▾</option>
            <option value="1">Semester 1 ▾</option>
            <option value="2">Semester 2 ▾</option>
          </select>
        </div>

        <a href="subjects.html" class="btn-cyan-back text-sm">
          ← Back
        </a>
      </div>
    </div>

    <!-- 1. Branch Picker (shown only for subjects that have branches, e.g. Religion) -->
    <div id="branchPickerContainer" class="hidden pt-6">
      <div class="mb-6">
        <h2 class="text-xl font-bold text-white mb-1">Select Study Branch</h2>
        <p class="text-xs text-slate-400">Please choose your curriculum track to view specific units and outcomes.</p>
      </div>
      <div class="flex flex-wrap items-center gap-8" id="branchGrid">
          <a href="subject.html?s=religion&b=islam" class="figma-detail-card group">
            <div class="card-title">Islam</div>
            <div class="w-full flex items-center justify-center transform group-hover:scale-105 transition-transform duration-300"><svg class="w-16 h-16 text-[#48A9A6]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 19V7a2 2 0 012-2h12a2 2 0 012 2v12M4 19h16M8 5v6a4 4 0 008 0V5"/></svg></div>
            <div class="text-xs text-[#F5BC6B] mt-3 font-semibold flex items-center gap-1">Explore Study Units →</div>
          </a>
          <a href="subject.html?s=religion&b=christian" class="figma-detail-card group">
            <div class="card-title">Christian</div>
            <div class="w-full flex items-center justify-center transform group-hover:scale-105 transition-transform duration-300"><svg class="w-16 h-16 text-[#F5BC6B]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v18M6 8h12"/></svg></div>
            <div class="text-xs text-[#F5BC6B] mt-3 font-semibold flex items-center gap-1">Explore Study Units →</div>
          </a>
      </div>
    </div>

    <!-- 2. Learning Outcomes (LOs): STATIC cards. Add a card by copy-pasting an <a class="lo-card"> block into the right subject-group. -->
    <div id="losContainer" class="pt-4">
      <div id="subjectLOsGrid">
        <div class="subject-group grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-subject="geology" data-branch="" data-name="Geology" data-category="scientific" data-description="Earth systems, plate tectonics, mineralogy, stratigraphy, and geological processes." hidden>
          <a href="lesson.html?id=ES.1.01" class="lo-card  group" data-branch="" data-semester="1" hidden>
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-[#F5BC6B] bg-[#F5BC6B]/10 px-3 py-1 rounded-full border border-[#F5BC6B]/20">ES.1.01</span>
                <span class="badge-uploaded">● Available</span>
              </div>
              <h3 class="text-base md:text-lg font-bold text-white group-hover:text-[#F5BC6B] transition-colors mb-2">Earth Systems &amp; Geosphere Spheres</h3>
              <p class="text-xs text-slate-300 line-clamp-2 mb-4 leading-relaxed">Atmosphere, hydrosphere, lithosphere, biosphere interactions, and Earth's layered internal structure.</p>
            </div>
            <div class="pt-3 border-t border-[#163E60] flex items-center justify-between text-xs text-slate-400">
              <span class="font-medium">Weeks: 01-03</span>
              <span class="text-[#38B2AC] font-semibold flex items-center gap-1 group-hover:translate-x-1 transition-transform">1 Videos • 1 Files • 1 Tests</span>
            </div>
          </a>
          <a href="lesson.html?id=ES.1.02" class="lo-card unuploaded group" data-branch="" data-semester="1" hidden>
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-[#F5BC6B] bg-[#F5BC6B]/10 px-3 py-1 rounded-full border border-[#F5BC6B]/20">ES.1.02</span>
                <span class="badge-pending">Not uploaded yet</span>
              </div>
              <h3 class="text-base md:text-lg font-bold text-white group-hover:text-[#F5BC6B] transition-colors mb-2">Plate Tectonics &amp; Continental Drift</h3>
              <p class="text-xs text-slate-300 line-clamp-2 mb-4 leading-relaxed">Divergent, convergent, and transform boundaries, seafloor spreading, and Egyptian rift systems.</p>
            </div>
            <div class="pt-3 border-t border-[#163E60] flex items-center justify-between text-xs text-slate-400">
              <span class="font-medium">Weeks: 04-06</span>
              <span class="text-[#38B2AC] font-semibold flex items-center gap-1 group-hover:translate-x-1 transition-transform">View Outline →</span>
            </div>
          </a>
          <a href="lesson.html?id=ES.1.03" class="lo-card unuploaded group" data-branch="" data-semester="1" hidden>
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-[#F5BC6B] bg-[#F5BC6B]/10 px-3 py-1 rounded-full border border-[#F5BC6B]/20">ES.1.03</span>
                <span class="badge-pending">Not uploaded yet</span>
              </div>
              <h3 class="text-base md:text-lg font-bold text-white group-hover:text-[#F5BC6B] transition-colors mb-2">Mineralogy &amp; Crystal Systems</h3>
              <p class="text-xs text-slate-300 line-clamp-2 mb-4 leading-relaxed">Physical properties of minerals, Mohs hardness, cleavage, silicates, and crystal lattice forms.</p>
            </div>
            <div class="pt-3 border-t border-[#163E60] flex items-center justify-between text-xs text-slate-400">
              <span class="font-medium">Weeks: 07-09</span>
              <span class="text-[#38B2AC] font-semibold flex items-center gap-1 group-hover:translate-x-1 transition-transform">View Outline →</span>
            </div>
          </a>
          <a href="lesson.html?id=ES.1.04" class="lo-card unuploaded group" data-branch="" data-semester="2" hidden>
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-[#F5BC6B] bg-[#F5BC6B]/10 px-3 py-1 rounded-full border border-[#F5BC6B]/20">ES.1.04</span>
                <span class="badge-pending">Not uploaded yet</span>
              </div>
              <h3 class="text-base md:text-lg font-bold text-white group-hover:text-[#F5BC6B] transition-colors mb-2">Rock Cycle &amp; Igneous Petrology</h3>
              <p class="text-xs text-slate-300 line-clamp-2 mb-4 leading-relaxed">Magma crystallization, Bowen's reaction series, intrusive vs extrusive volcanic structures.</p>
            </div>
            <div class="pt-3 border-t border-[#163E60] flex items-center justify-between text-xs text-slate-400">
              <span class="font-medium">Weeks: 01-04</span>
              <span class="text-[#38B2AC] font-semibold flex items-center gap-1 group-hover:translate-x-1 transition-transform">View Outline →</span>
            </div>
          </a>
          <a href="lesson.html?id=ES.1.05" class="lo-card unuploaded group" data-branch="" data-semester="2" hidden>
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-[#F5BC6B] bg-[#F5BC6B]/10 px-3 py-1 rounded-full border border-[#F5BC6B]/20">ES.1.05</span>
                <span class="badge-pending">Not uploaded yet</span>
              </div>
              <h3 class="text-base md:text-lg font-bold text-white group-hover:text-[#F5BC6B] transition-colors mb-2">Sedimentary &amp; Metamorphic Processes in Egypt</h3>
              <p class="text-xs text-slate-300 line-clamp-2 mb-4 leading-relaxed">Weathering, erosion, lithification, metamorphic grades, and Nile Basin stratigraphy.</p>
            </div>
            <div class="pt-3 border-t border-[#163E60] flex items-center justify-between text-xs text-slate-400">
              <span class="font-medium">Weeks: 05-09</span>
              <span class="text-[#38B2AC] font-semibold flex items-center gap-1 group-hover:translate-x-1 transition-transform">View Outline →</span>
            </div>
          </a>
        </div>
        <div class="subject-group grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-subject="math" data-branch="" data-name="Math" data-category="scientific" data-description="Differential and integral calculus, linear algebra, analytical geometry, and probability." hidden>
          <a href="lesson.html?id=MA.1.01" class="lo-card  group" data-branch="" data-semester="1" hidden>
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-[#F5BC6B] bg-[#F5BC6B]/10 px-3 py-1 rounded-full border border-[#F5BC6B]/20">MA.1.01</span>
                <span class="badge-uploaded">● Available</span>
              </div>
              <h3 class="text-base md:text-lg font-bold text-white group-hover:text-[#F5BC6B] transition-colors mb-2">Functions, Domain &amp; Range, Transformations</h3>
              <p class="text-xs text-slate-300 line-clamp-2 mb-4 leading-relaxed">Polynomial, rational, radical functions, composite functions, and graph transformations.</p>
            </div>
            <div class="pt-3 border-t border-[#163E60] flex items-center justify-between text-xs text-slate-400">
              <span class="font-medium">Weeks: 01-02</span>
              <span class="text-[#38B2AC] font-semibold flex items-center gap-1 group-hover:translate-x-1 transition-transform">1 Videos • 1 Files • 1 Tests</span>
            </div>
          </a>
          <a href="lesson.html?id=MA.1.02" class="lo-card  group" data-branch="" data-semester="1" hidden>
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-[#F5BC6B] bg-[#F5BC6B]/10 px-3 py-1 rounded-full border border-[#F5BC6B]/20">MA.1.02</span>
                <span class="badge-uploaded">● Available</span>
              </div>
              <h3 class="text-base md:text-lg font-bold text-white group-hover:text-[#F5BC6B] transition-colors mb-2">Limits &amp; Continuity</h3>
              <p class="text-xs text-slate-300 line-clamp-2 mb-4 leading-relaxed">Algebraic limits, limits at infinity, squeeze theorem, and one-sided continuity.</p>
            </div>
            <div class="pt-3 border-t border-[#163E60] flex items-center justify-between text-xs text-slate-400">
              <span class="font-medium">Weeks: 03-04</span>
              <span class="text-[#38B2AC] font-semibold flex items-center gap-1 group-hover:translate-x-1 transition-transform">1 Videos • 1 Files • 1 Tests</span>
            </div>
          </a>
          <a href="lesson.html?id=MA.1.03" class="lo-card unuploaded group" data-branch="" data-semester="1" hidden>
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-[#F5BC6B] bg-[#F5BC6B]/10 px-3 py-1 rounded-full border border-[#F5BC6B]/20">MA.1.03</span>
                <span class="badge-pending">Not uploaded yet</span>
              </div>
              <h3 class="text-base md:text-lg font-bold text-white group-hover:text-[#F5BC6B] transition-colors mb-2">Differential Calculus: Definition &amp; Rules</h3>
              <p class="text-xs text-slate-300 line-clamp-2 mb-4 leading-relaxed">Derivative as rate of change, power, product, quotient, and chain rules.</p>
            </div>
            <div class="pt-3 border-t border-[#163E60] flex items-center justify-between text-xs text-slate-400">
              <span class="font-medium">Weeks: 05-06</span>
              <span class="text-[#38B2AC] font-semibold flex items-center gap-1 group-hover:translate-x-1 transition-transform">View Outline →</span>
            </div>
          </a>
          <a href="lesson.html?id=MA.1.04" class="lo-card unuploaded group" data-branch="" data-semester="1" hidden>
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-[#F5BC6B] bg-[#F5BC6B]/10 px-3 py-1 rounded-full border border-[#F5BC6B]/20">MA.1.04</span>
                <span class="badge-pending">Not uploaded yet</span>
              </div>
              <h3 class="text-base md:text-lg font-bold text-white group-hover:text-[#F5BC6B] transition-colors mb-2">Related Rates &amp; Optimization Problems</h3>
              <p class="text-xs text-slate-300 line-clamp-2 mb-4 leading-relaxed">Implicit differentiation, related rates modeling, and global extrema optimization.</p>
            </div>
            <div class="pt-3 border-t border-[#163E60] flex items-center justify-between text-xs text-slate-400">
              <span class="font-medium">Weeks: 07-08</span>
              <span class="text-[#38B2AC] font-semibold flex items-center gap-1 group-hover:translate-x-1 transition-transform">View Outline →</span>
            </div>
          </a>
          <a href="lesson.html?id=MA.1.05" class="lo-card unuploaded group" data-branch="" data-semester="2" hidden>
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-[#F5BC6B] bg-[#F5BC6B]/10 px-3 py-1 rounded-full border border-[#F5BC6B]/20">MA.1.05</span>
                <span class="badge-pending">Not uploaded yet</span>
              </div>
              <h3 class="text-base md:text-lg font-bold text-white group-hover:text-[#F5BC6B] transition-colors mb-2">Matrices, Determinants &amp; Linear Systems</h3>
              <p class="text-xs text-slate-300 line-clamp-2 mb-4 leading-relaxed">Matrix operations, determinants, Cramer's rule, inverse matrices, and Gaussian elimination.</p>
            </div>
            <div class="pt-3 border-t border-[#163E60] flex items-center justify-between text-xs text-slate-400">
              <span class="font-medium">Weeks: 01-03</span>
              <span class="text-[#38B2AC] font-semibold flex items-center gap-1 group-hover:translate-x-1 transition-transform">View Outline →</span>
            </div>
          </a>
          <a href="lesson.html?id=MA.1.06" class="lo-card unuploaded group" data-branch="" data-semester="2" hidden>
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-[#F5BC6B] bg-[#F5BC6B]/10 px-3 py-1 rounded-full border border-[#F5BC6B]/20">MA.1.06</span>
                <span class="badge-pending">Not uploaded yet</span>
              </div>
              <h3 class="text-base md:text-lg font-bold text-white group-hover:text-[#F5BC6B] transition-colors mb-2">Analytical Trigonometry &amp; Identities</h3>
              <p class="text-xs text-slate-300 line-clamp-2 mb-4 leading-relaxed">Angle addition formulas, double angles, law of sines/cosines, and trigonometric equations.</p>
            </div>
            <div class="pt-3 border-t border-[#163E60] flex items-center justify-between text-xs text-slate-400">
              <span class="font-medium">Weeks: 04-06</span>
              <span class="text-[#38B2AC] font-semibold flex items-center gap-1 group-hover:translate-x-1 transition-transform">View Outline →</span>
            </div>
          </a>
          <a href="lesson.html?id=MA.1.07" class="lo-card unuploaded group" data-branch="" data-semester="2" hidden>
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-[#F5BC6B] bg-[#F5BC6B]/10 px-3 py-1 rounded-full border border-[#F5BC6B]/20">MA.1.07</span>
                <span class="badge-pending">Not uploaded yet</span>
              </div>
              <h3 class="text-base md:text-lg font-bold text-white group-hover:text-[#F5BC6B] transition-colors mb-2">Introduction to Integral Calculus</h3>
              <p class="text-xs text-slate-300 line-clamp-2 mb-4 leading-relaxed">Antiderivatives, Riemann sums, Fundamental Theorem of Calculus, and u-substitution.</p>
            </div>
            <div class="pt-3 border-t border-[#163E60] flex items-center justify-between text-xs text-slate-400">
              <span class="font-medium">Weeks: 07-09</span>
              <span class="text-[#38B2AC] font-semibold flex items-center gap-1 group-hover:translate-x-1 transition-transform">View Outline →</span>
            </div>
          </a>
