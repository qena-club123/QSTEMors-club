  <!-- Static lesson controller: fills the header + 3 sections from the matching block above -->
  <script>
    (function () {
      var id = (new URLSearchParams(window.location.search).get('id') || '').toLowerCase();
      var store = document.getElementById('lessonDataStore');
      var blocks = store ? [].slice.call(store.querySelectorAll('.lesson-data')) : [];
      var block = null;
      for (var i = 0; i < blocks.length; i++) { if (blocks[i].dataset.id.toLowerCase() === id) { block = blocks[i]; break; } }
      if (!block) { alert('Lesson outcome not found.'); window.location.href = 'subjects.html'; return; }
      var d = block.dataset;
      var subjHref = 'subject.html?s=' + d.subject + (d.branch ? '&b=' + d.branch : '');
      function setTxt(elId, val) { var e = document.getElementById(elId); if (e) e.textContent = val; }
      var bs = document.getElementById('breadcrumbSubject'); if (bs) { bs.textContent = d.subjectName; bs.href = subjHref; }
      setTxt('breadcrumbLO', d.id);
      var back = document.getElementById('lessonBackBtn'); if (back) back.href = subjHref;
      setTxt('lessonCodeTitle', d.code);
      setTxt('lessonMainTitle', d.title);
      setTxt('lessonDescription', d.desc);
      setTxt('lessonMetaBadge', d.meta);
      function fill(containerId, slot, badgeId, badgeText) {
        var c = document.getElementById(containerId);
        var s = block.querySelector('[data-slot="' + slot + '"]');
        if (c && s) c.innerHTML = s.innerHTML;
        var b = document.getElementById(badgeId); if (b) b.textContent = badgeText;
      }
      fill('videosListContainer', 'videos', 'videosCountBadge', d.videos + ' Lectures');
      fill('filesListContainer', 'files', 'filesCountBadge', d.files + ' Files');
      fill('testBanksListContainer', 'tests', 'testBanksCountBadge', d.tests + ' Question Banks');
    })();
  </script>

  <!-- Application Scripts -->
  <script src="assets/assets.js"></script>
  <script src="assets/app.js"></script>
