  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brandDark: '#0A1926',
            brandDarker: '#07131F',
            brandCard: '#0E2238',
            brandGold: '#F5BC6B',
            brandTeal: '#48A9A6',
            brandCyan: '#38B2AC',
          },
          fontFamily: {
            sans: ['Poppins', 'Outfit', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <!-- Favicon -->
  <link rel="icon" type="image/jpeg" href="assets/images/logo.jpg">

  <!-- Custom Stylesheet -->
  <link rel="stylesheet" href="assets/style.css">
  <link rel="stylesheet" href="css/styles.css">
</head>
<body class="bg-[#071A26] text-white min-h-screen flex flex-col selection:bg-[#F5BC6B] selection:text-[#071A26]">

  <!-- Top Navigation Bar -->
  <header class="sticky top-0 z-40 bg-[#071A26]/95 backdrop-blur-md border-b border-[#0F2F47] transition-all">
