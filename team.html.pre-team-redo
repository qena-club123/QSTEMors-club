  <!-- Team branch tabs: show one team grid at a time (Seniors '28 current / Seniors '26 alumni) -->
  <script>
    (function () {
      var tabs = [].slice.call(document.querySelectorAll('#teamBranchTabs .team-tab'));
      var branches = [].slice.call(document.querySelectorAll('.team-branch'));
      function select(branch) {
        branches.forEach(function (g) { g.classList.toggle('hidden', g.dataset.branch !== branch); });
        tabs.forEach(function (t) {
          var on = t.dataset.branch === branch;
          t.classList.toggle('btn-gold', on);
          t.classList.toggle('btn-gold-outline', !on);
        });
      }
      tabs.forEach(function (t) { t.addEventListener('click', function () { select(t.dataset.branch); }); });
      select('s28'); // default: current team
    })();
  </script>

