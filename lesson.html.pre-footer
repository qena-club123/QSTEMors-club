      <a href="partners.html" class="nav-link block py-2 text-base font-medium text-slate-300 hover:text-[#F5BC6B]" data-page="partners">Partners</a>
      <div class="pt-2">
        <button class="btn-gold btn-join-trigger w-full text-center py-2.5">JOIN</button>
      </div>
    </div>
  </header>

  <!-- Main View Container -->
  <main class="flex-grow py-12 px-4 max-w-7xl mx-auto w-full">
    
    <!-- Top Breadcrumb & LO Header -->
    <div class="flex flex-wrap items-center justify-between gap-4 mb-10 pb-6 border-b border-[#0F2F47]">
      <div>
        <!-- Breadcrumbs -->
        <div class="flex items-center gap-2 text-xs text-slate-400 font-medium mb-2">
          <a href="subjects.html" class="hover:text-[#F5BC6B]">Subjects</a>
          <span>&gt;</span>
          <a id="breadcrumbSubject" href="subjects.html" class="text-slate-300 hover:text-[#F5BC6B]">Subject</a>
          <span>&gt;</span>
          <span id="breadcrumbLO" class="text-[#F5BC6B] font-bold">L.O Code</span>
        </div>

        <div class="flex items-center gap-3">
          <h1 id="lessonCodeTitle" class="text-2xl md:text-4xl font-extrabold text-white tracking-tight letter-spaced-title">
            The_Subject &gt; L.O NO.
          </h1>
          <span id="lessonMetaBadge" class="hidden sm:inline-block bg-[#163E60] text-[#38B2AC] text-xs font-bold px-3 py-1 rounded-full">
            Grade 1 STEM
          </span>
        </div>

        <h2 id="lessonMainTitle" class="text-lg md:text-xl font-bold text-[#38B2AC] mt-2">
          Loading learning outcome...
        </h2>
        <p id="lessonDescription" class="text-xs md:text-sm text-slate-300 mt-1 max-w-3xl">
          Loading description...
        </p>
      </div>

      <div>
        <a id="lessonBackBtn" href="subjects.html" class="btn-cyan-back text-sm">
          ← Back to L.Os
        </a>
      </div>
    </div>

    <!-- ONE SINGLE PAGE IN ONE SCROLL: 3 SECTIONS -->
    <div class="space-y-10">
      
      <!-- 1. VIDEOS SECTION -->
      <section class="resource-section">
        <div class="flex items-center justify-between gap-4 mb-6 pb-4 border-b border-[#143E62]">
          <div class="flex items-center gap-3">
            <span class="text-2xl md:text-3xl">🎬</span>
            <div>
              <h3 class="text-xl md:text-2xl font-extrabold text-white">Video Lessons & Explanations</h3>
              <p class="text-xs text-slate-400">Concept breakdowns and reference proof derivations recorded by mentors and teachers.</p>
            </div>
          </div>
          <span id="videosCountBadge" class="bg-[#F5BC6B]/10 text-[#F5BC6B] border border-[#F5BC6B]/30 text-xs font-bold px-3 py-1 rounded-full">
            0 Lectures
          </span>
        </div>

        <div id="videosListContainer" class="space-y-4">
          <!-- Populated dynamically via assets/app.js -->
        </div>
      </section>

      <!-- 2. FILES & PPT PRESENTATIONS SECTION -->
      <section class="resource-section">
        <div class="flex items-center justify-between gap-4 mb-6 pb-4 border-b border-[#143E62]">
          <div class="flex items-center gap-3">
            <span class="text-2xl md:text-3xl">📁</span>
            <div>
              <h3 class="text-xl md:text-2xl font-extrabold text-white">Study Files & Slide Decks</h3>
              <p class="text-xs text-slate-400">PowerPoint presentations crafted by visual designers and summary review sheets.</p>
            </div>
          </div>
          <span id="filesCountBadge" class="bg-[#38B2AC]/10 text-[#38B2AC] border border-[#38B2AC]/30 text-xs font-bold px-3 py-1 rounded-full">
            0 Files
          </span>
        </div>

        <div id="filesListContainer" class="space-y-4">
          <!-- Populated dynamically via assets/app.js -->
        </div>
      </section>

      <!-- 3. TEST BANKS & REFERENCE QUESTIONS SECTION -->
      <section class="resource-section">
        <div class="flex items-center justify-between gap-4 mb-6 pb-4 border-b border-[#143E62]">
          <div class="flex items-center gap-3">
            <span class="text-2xl md:text-3xl">📝</span>
            <div>
              <h3 class="text-xl md:text-2xl font-extrabold text-white">Test Banks & Practice Sets</h3>
              <p class="text-xs text-slate-400">Challenging university reference problems, multiple-choice questions, and answer keys.</p>
            </div>
          </div>
          <span id="testBanksCountBadge" class="bg-[#2ECC71]/10 text-[#2ECC71] border border-[#2ECC71]/30 text-xs font-bold px-3 py-1 rounded-full">
            0 Question Banks
          </span>
        </div>

        <div id="testBanksListContainer" class="space-y-4">
          <!-- Populated dynamically via assets/app.js -->
        </div>
      </section>

    </div>

    <!-- STATIC lesson content store: one block per L.O. All videos/files/tests live here as HTML. -->
