  </div>

  <!-- Static catalog filter: shows/hides the subject cards above (no data fetch) -->
  <script>
    (function () {
      var cards = [].slice.call(document.querySelectorAll('#subjectsCatalogGrid .subject-card'));
      var empty = document.getElementById('subjectsEmptyNotice');
      var sem = document.getElementById('catalogSemesterSelect');
      var search = document.getElementById('catalogSearchInput');
      var cat = 'all';
      function apply() {
        var q = (search && search.value || '').trim().toLowerCase();
        var s = sem ? sem.value : 'all';
        var shown = 0;
        cards.forEach(function (c) {
          var okCat = cat === 'all' || c.dataset.category === cat;
          var okSem = s === 'all' || (c.dataset.semesters || '').split(',').indexOf(s) > -1;
          var okQ = !q || (c.dataset.name || '').indexOf(q) > -1 || (c.dataset.desc || '').indexOf(q) > -1;
          var ok = okCat && okSem && okQ;
          c.hidden = !ok; if (ok) shown++;
        });
        if (empty) empty.classList.toggle('hidden', shown > 0);
      }
      document.querySelectorAll('.category-filter-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          document.querySelectorAll('.category-filter-btn').forEach(function (b) { b.classList.remove('active'); });
          btn.classList.add('active'); cat = btn.getAttribute('data-category'); apply();
        });
      });
      if (sem) sem.addEventListener('change', apply);
      if (search) search.addEventListener('input', apply);
      apply();
    })();
  </script>

  <!-- Application Scripts -->
  <script src="assets/assets.js"></script>
  <script src="assets/app.js"></script>
